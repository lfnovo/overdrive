# Generate secrets with: python3 scripts/configure_local.py --admin-email you@example.com
APP_URL=http://localhost:18765
WORKSPACE_NAME=Overdrive
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
SESSION_SECRET=generate-with-scripts-configure-local
SURREAL_URL=http://localhost:8019
SURREAL_NAMESPACE=overdrive
SURREAL_DATABASE=app
SURREAL_USER=overdrive_app
SURREAL_PASS=generate-with-scripts-configure-local
BOOTSTRAP_USER=root
BOOTSTRAP_PASS=generate-with-scripts-configure-local
STORAGE_PATH=.local/attachments
DEV_LOGIN=false
DEV_LOGIN_ALLOW_REMOTE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign-in methods: local passwords, Google, or both.
LOCAL_LOGIN=true
GOOGLE_LOGIN=true
