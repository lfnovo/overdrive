-- Initial schema. Idempotent; no DROP/REMOVE statements.
DEFINE TABLE IF NOT EXISTS unit SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS version ON unit TYPE int;
DEFINE FIELD IF NOT EXISTS created_at ON unit TYPE string;
DEFINE FIELD IF NOT EXISTS updated_at ON unit TYPE string;
DEFINE FIELD IF NOT EXISTS name ON unit TYPE string;
DEFINE FIELD IF NOT EXISTS archived ON unit TYPE bool;
DEFINE TABLE IF NOT EXISTS user SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS version ON user TYPE int;
DEFINE FIELD IF NOT EXISTS created_at ON user TYPE string;
DEFINE FIELD IF NOT EXISTS updated_at ON user TYPE string;
DEFINE FIELD IF NOT EXISTS name ON user TYPE string;
DEFINE FIELD IF NOT EXISTS email ON user TYPE string;
DEFINE FIELD IF NOT EXISTS active ON user TYPE bool;
DEFINE FIELD IF NOT EXISTS admin ON user TYPE bool;
DEFINE FIELD IF NOT EXISTS units ON user TYPE array<record<unit>>;
DEFINE FIELD IF NOT EXISTS google_sub ON user TYPE option<string>;
DEFINE TABLE IF NOT EXISTS organization SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS version ON organization TYPE int;
DEFINE FIELD IF NOT EXISTS created_at ON organization TYPE string;
DEFINE FIELD IF NOT EXISTS updated_at ON organization TYPE string;
DEFINE FIELD IF NOT EXISTS name ON organization TYPE string;
DEFINE FIELD IF NOT EXISTS domain ON organization TYPE string;
DEFINE FIELD IF NOT EXISTS archived ON organization TYPE bool;
DEFINE TABLE IF NOT EXISTS contact SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS version ON contact TYPE int;
DEFINE FIELD IF NOT EXISTS created_at ON contact TYPE string;
DEFINE FIELD IF NOT EXISTS updated_at ON contact TYPE string;
DEFINE FIELD IF NOT EXISTS name ON contact TYPE string;
DEFINE FIELD IF NOT EXISTS email ON contact TYPE string;
DEFINE FIELD IF NOT EXISTS phone ON contact TYPE string;
DEFINE FIELD IF NOT EXISTS organization ON contact TYPE option<record<organization>>;
DEFINE FIELD IF NOT EXISTS archived ON contact TYPE bool;
DEFINE TABLE IF NOT EXISTS deal SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS version ON deal TYPE int;
DEFINE FIELD IF NOT EXISTS created_at ON deal TYPE string;
DEFINE FIELD IF NOT EXISTS updated_at ON deal TYPE string;
DEFINE FIELD IF NOT EXISTS title ON deal TYPE string;
DEFINE FIELD IF NOT EXISTS deal_so_far ON deal TYPE string DEFAULT "";
DEFINE FIELD IF NOT EXISTS deal_so_far_updated_at ON deal TYPE option<string>;
DEFINE FIELD IF NOT EXISTS deal_so_far_author ON deal TYPE option<string>;
DEFINE FIELD IF NOT EXISTS unit ON deal TYPE option<record<unit>>;
DEFINE FIELD IF NOT EXISTS organization ON deal TYPE option<record<organization>>;
DEFINE FIELD IF NOT EXISTS owner ON deal TYPE option<record<user>>;
DEFINE FIELD IF NOT EXISTS stage ON deal TYPE string;
DEFINE FIELD IF NOT EXISTS outcome ON deal TYPE string;
DEFINE FIELD IF NOT EXISTS loss_reason ON deal TYPE string;
DEFINE FIELD IF NOT EXISTS value_cents ON deal TYPE int;
DEFINE FIELD IF NOT EXISTS expected_close ON deal TYPE option<string>;
DEFINE FIELD IF NOT EXISTS archived ON deal TYPE bool;
DEFINE FIELD IF NOT EXISTS current_proposal ON deal TYPE option<record<proposal_version>>;
DEFINE TABLE IF NOT EXISTS deal_contact SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS version ON deal_contact TYPE int;
DEFINE FIELD IF NOT EXISTS created_at ON deal_contact TYPE string;
DEFINE FIELD IF NOT EXISTS updated_at ON deal_contact TYPE string;
DEFINE FIELD IF NOT EXISTS deal ON deal_contact TYPE record<deal>;
DEFINE FIELD IF NOT EXISTS contact ON deal_contact TYPE record<contact>;
DEFINE TABLE IF NOT EXISTS task SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS version ON task TYPE int;
DEFINE FIELD IF NOT EXISTS created_at ON task TYPE string;
DEFINE FIELD IF NOT EXISTS updated_at ON task TYPE string;
DEFINE FIELD IF NOT EXISTS deal ON task TYPE record<deal>;
DEFINE FIELD IF NOT EXISTS title ON task TYPE string;
DEFINE FIELD IF NOT EXISTS description ON task TYPE string;
DEFINE FIELD IF NOT EXISTS owner ON task TYPE record<user>;
DEFINE FIELD IF NOT EXISTS due ON task TYPE option<string>;
DEFINE FIELD IF NOT EXISTS done ON task TYPE bool;
DEFINE FIELD IF NOT EXISTS primary ON task TYPE bool;
DEFINE TABLE IF NOT EXISTS note SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS version ON note TYPE int;
DEFINE FIELD IF NOT EXISTS created_at ON note TYPE string;
DEFINE FIELD IF NOT EXISTS updated_at ON note TYPE string;
DEFINE FIELD IF NOT EXISTS deal ON note TYPE record<deal>;
DEFINE FIELD IF NOT EXISTS content ON note TYPE string;
DEFINE FIELD IF NOT EXISTS actor ON note TYPE record<user>;
-- Legacy archive only: no proposal API/UI. Retained for migration and old backups.
DEFINE TABLE IF NOT EXISTS proposal_version SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS version ON proposal_version TYPE int;
DEFINE FIELD IF NOT EXISTS created_at ON proposal_version TYPE string;
DEFINE FIELD IF NOT EXISTS updated_at ON proposal_version TYPE string;
DEFINE FIELD IF NOT EXISTS deal ON proposal_version TYPE record<deal>;
DEFINE FIELD IF NOT EXISTS markdown ON proposal_version TYPE string;
DEFINE FIELD IF NOT EXISTS gamma_url ON proposal_version TYPE string;
DEFINE FIELD IF NOT EXISTS attachment ON proposal_version TYPE option<record<attachment>>;
DEFINE FIELD IF NOT EXISTS number ON proposal_version TYPE int;
DEFINE FIELD IF NOT EXISTS sent_at ON proposal_version TYPE option<string>;
DEFINE TABLE IF NOT EXISTS attachment SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS version ON attachment TYPE int;
DEFINE FIELD IF NOT EXISTS created_at ON attachment TYPE string;
DEFINE FIELD IF NOT EXISTS updated_at ON attachment TYPE string;
DEFINE FIELD IF NOT EXISTS deal ON attachment TYPE record<deal>;
DEFINE FIELD OVERWRITE name ON attachment TYPE option<string>;
DEFINE FIELD OVERWRITE mime ON attachment TYPE option<string>;
DEFINE FIELD OVERWRITE size ON attachment TYPE option<int>;
DEFINE FIELD OVERWRITE checksum ON attachment TYPE option<string>;
DEFINE FIELD OVERWRITE storage_key ON attachment TYPE option<string>;
DEFINE TABLE IF NOT EXISTS audit_event SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS version ON audit_event TYPE int;
DEFINE FIELD IF NOT EXISTS created_at ON audit_event TYPE string;
DEFINE FIELD IF NOT EXISTS updated_at ON audit_event TYPE string;
DEFINE FIELD IF NOT EXISTS deal ON audit_event TYPE option<record<deal>>;
DEFINE FIELD IF NOT EXISTS target ON audit_event TYPE string;
DEFINE FIELD IF NOT EXISTS action ON audit_event TYPE string;
DEFINE FIELD IF NOT EXISTS actor ON audit_event TYPE record<user>;
DEFINE FIELD IF NOT EXISTS actor_name ON audit_event TYPE string;
DEFINE FIELD IF NOT EXISTS channel ON audit_event TYPE string;
DEFINE FIELD IF NOT EXISTS client ON audit_event TYPE string;
DEFINE FIELD IF NOT EXISTS changes ON audit_event TYPE object FLEXIBLE;
DEFINE TABLE IF NOT EXISTS idempotency_request SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS version ON idempotency_request TYPE int;
DEFINE FIELD IF NOT EXISTS created_at ON idempotency_request TYPE string;
DEFINE FIELD IF NOT EXISTS updated_at ON idempotency_request TYPE string;
DEFINE FIELD IF NOT EXISTS actor ON idempotency_request TYPE record<user>;
DEFINE FIELD IF NOT EXISTS operation ON idempotency_request TYPE string;
DEFINE FIELD IF NOT EXISTS request_key ON idempotency_request TYPE string;
DEFINE FIELD IF NOT EXISTS payload_hash ON idempotency_request TYPE string;
DEFINE FIELD IF NOT EXISTS target ON idempotency_request TYPE string;
DEFINE TABLE IF NOT EXISTS auth_record SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS version ON auth_record TYPE int;
DEFINE FIELD IF NOT EXISTS created_at ON auth_record TYPE string;
DEFINE FIELD IF NOT EXISTS updated_at ON auth_record TYPE string;
DEFINE FIELD IF NOT EXISTS kind ON auth_record TYPE string;
DEFINE FIELD IF NOT EXISTS payload ON auth_record TYPE object FLEXIBLE;
DEFINE FIELD IF NOT EXISTS expires_at ON auth_record TYPE int;
DEFINE INDEX IF NOT EXISTS user_email ON user FIELDS email UNIQUE;
DEFINE INDEX IF NOT EXISTS deal_unit ON deal FIELDS unit;
DEFINE INDEX IF NOT EXISTS task_deal ON task FIELDS deal;
DEFINE INDEX IF NOT EXISTS link_pair ON deal_contact FIELDS deal, contact UNIQUE;
DEFINE INDEX IF NOT EXISTS request_key ON idempotency_request FIELDS actor, operation, request_key UNIQUE;
DEFINE INDEX IF NOT EXISTS proposal_number ON proposal_version FIELDS deal, number UNIQUE;
DEFINE FIELD IF NOT EXISTS response ON idempotency_request TYPE option<object> FLEXIBLE;

-- Generic files and links; binary metadata is set only by the upload service.
DEFINE FIELD IF NOT EXISTS title ON attachment TYPE string DEFAULT '';
DEFINE FIELD IF NOT EXISTS description ON attachment TYPE string DEFAULT '';
DEFINE FIELD IF NOT EXISTS url ON attachment TYPE string DEFAULT '';
DEFINE FIELD IF NOT EXISTS deprecated ON attachment TYPE bool DEFAULT false;
DEFINE FIELD IF NOT EXISTS created_by ON attachment TYPE option<record<user>>;
DEFINE FIELD IF NOT EXISTS creator_name ON attachment TYPE string DEFAULT '';

DEFINE FIELD IF NOT EXISTS materials_migrated ON proposal_version TYPE bool DEFAULT false;

DEFINE TABLE IF NOT EXISTS source SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS version ON source TYPE int;
DEFINE FIELD IF NOT EXISTS created_at ON source TYPE string;
DEFINE FIELD IF NOT EXISTS updated_at ON source TYPE string;
DEFINE FIELD IF NOT EXISTS name ON source TYPE string;
DEFINE FIELD IF NOT EXISTS archived ON source TYPE bool;
DEFINE FIELD IF NOT EXISTS source ON deal TYPE option<record<source>>;
